# =============================================================================
# Graph-engine Dockerfile (pure Go, no igraph)
# =============================================================================
# This Dockerfile builds graph-engine WITHOUT CGO/igraph.
# The binary will use pure Go fallback implementations for all algorithms.
# This produces a smaller image but may be slower for large graphs.
#
# Build:
#   docker build -f Dockerfile.nocgo -t graph-engine:nocgo .
#
# For full igraph support, use the default Dockerfile instead.
# =============================================================================

# Build stage
FROM golang:1.23-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git make

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the binary without CGO
ARG VERSION=dev
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X 'github.com/naisa-ai/graph-engine/internal/api/grpc.Version=${VERSION}' -X 'github.com/naisa-ai/graph-engine/internal/api/grpc.BuildTime=${BUILD_TIME}'" \
    -o /app/graph-engined \
    ./cmd/graph-engined

# Runtime stage
FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies (CA certificates for TLS)
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN adduser -D -g '' appuser

# Copy binary from builder
COPY --from=builder /app/graph-engined /app/graph-engined

# Copy default config
COPY config.yaml /app/config.yaml

# Set ownership
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose gRPC port
EXPOSE 50051

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/app/graph-engined", "--help"] || exit 1

# Labels
LABEL org.opencontainers.image.title="graph-engine"
LABEL org.opencontainers.image.description="Graph Engine Service (pure Go, no igraph)"
LABEL org.opencontainers.image.source="https://github.com/naisa-ai/graph-engine"

# Run the service
ENTRYPOINT ["/app/graph-engined"]
CMD ["-config", "/app/config.yaml"]
